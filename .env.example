# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_YOUR_CHAT_ID=your_personal_chat_id
TELEGRAM_ALLOWED_CHAT_IDS=chat_id_1,chat_id_2,chat_id_3

# Splunk
SPLUNK_URL=https://your-splunk-instance.example.com
SPLUNK_SPL_TEMPLATES={"prod":"index=\"your_prod_index\" \"{transaction_id}\"","dev":"index=\"your_preprod_index\" \"{transaction_id}\"","staging":"index=\"your_preprod_index\" \"{transaction_id}\"","uat":"index=\"your_preprod_index\" \"{transaction_id}\""}
SPLUNK_SESSION_PATH=splunk_session.json
SPLUNK_API_SESSION_PATH=splunk_api_session.json
SPLUNK_RESULT_WAIT_TIMEOUT=30
SPLUNK_POLL_INTERVAL=2
SPLUNK_SKIP_SSL_VERIFY=true  # Set to true only if Splunk uses self-signed/corporate certificates (disables TLS verification)
SPLUNK_SSO_DOMAIN=login.example.com
SPLUNK_SSO_EMAIL=your_work_email@company.com
SPLUNK_SSO_EMPLOYEE_ID=your_employee_id
SPLUNK_SSO_PASSWORD=your_sso_password
MAX_LOG_LINES=100
SPLUNK_DEFAULT_TIME_RANGE=24h
SPLUNK_CORRELATION_ENABLED=true  # Follow data._id when the searched ID is a client-side ID (see AGENTS.md); set to false to always run a single search

# VPN check
VPN_CHECK_HOST=internal.your-company.com
TRANSACTION_ID_HEADER=X-Transaction-ID

# LLM (OpenAI)
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1  # Override if using reverse proxy
LLM_PROXY=  # HTTP/SOCKS5 proxy URL, e.g. socks5h://127.0.0.1:7890 (optional)
LLM_SKIP_SSL_VERIFY=true  # Set to true only if behind corporate VPN/proxy with self-signed certificates (disables TLS verification)

# App
TIMEZONE=Asia/Jakarta
DB_PATH=investigations.db