#!/bin/bash
set -e

resolve_repo_dir() {
    local source="$0"
    while [ -L "$source" ]; do
        local dir="$(cd -P "$(dirname "$source")" && pwd)"
        source="$(readlink "$source")"
        [[ "$source" != /* ]] && source="$dir/$source"
    done
    REPO_DIR="$(cd -P "$(dirname "$source")" && pwd)"
}

resolve_repo_dir

TEMPLATE_PLIST="$REPO_DIR/com.findbugs.bot.plist.template"
LAUNCH_AGENTS="$HOME/Library/LaunchAgents"
INSTALLED_PLIST="$LAUNCH_AGENTS/com.findbugs.bot.plist"

cmd="$1"

check_prerequisites() {
    if [ ! -f "$TEMPLATE_PLIST" ]; then
        echo "ERROR: $TEMPLATE_PLIST not found."
        exit 1
    fi
    if [ ! -d "$REPO_DIR/venv" ]; then
        echo "ERROR: Virtual environment not found."
        echo ""
        echo "Run setup first:"
        echo "  python3.11 -m venv venv"
        echo "  source venv/bin/activate"
        echo "  pip install -r requirements.txt"
        exit 1
    fi
    if [ ! -f "$REPO_DIR/splunk_api_session.json" ]; then
        echo "ERROR: Splunk session not found."
        echo ""
        echo "Run save_session.py first:"
        echo "  python save_session.py"
        exit 1
    fi
    mkdir -p "$REPO_DIR/logs"
}

install() {
    check_prerequisites
    mkdir -p "$LAUNCH_AGENTS"
    sed "s|{{REPO_DIR}}|$REPO_DIR|g" "$TEMPLATE_PLIST" > "$INSTALLED_PLIST"
    echo "Installed to $INSTALLED_PLIST"
}

uninstall() {
    if [ -f "$INSTALLED_PLIST" ]; then
        launchctl unload "$INSTALLED_PLIST" 2>/dev/null || true
        rm "$INSTALLED_PLIST"
        echo "Removed from $INSTALLED_PLIST"
    else
        echo "Not installed."
    fi
}

start() {
    check_prerequisites
    if [ ! -f "$INSTALLED_PLIST" ]; then
        install
    fi
    launchctl load "$INSTALLED_PLIST"
    echo "Bot started."
}

stop() {
    if [ -f "$INSTALLED_PLIST" ]; then
        launchctl unload "$INSTALLED_PLIST" 2>/dev/null || true
        echo "Bot stopped."
    else
        echo "Not running (plist not found)."
    fi
}

restart() {
    stop
    sleep 1
    start
}

status() {
    echo
    launchctl list | grep "com.findbugs.bot" || echo "Not running."
    echo
    if [ -f "$INSTALLED_PLIST" ]; then
        echo "Plist: $INSTALLED_PLIST (installed)"
    else
        echo "Plist: $INSTALLED_PLIST (NOT installed)"
    fi
}

logs() {
    exec tail -f "$REPO_DIR/logs/bot.log"
}

case "$cmd" in
    install)
        install
        ;;
    uninstall)
        uninstall
        ;;
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    logs)
        logs
        ;;
    *)
        echo "Usage: ./botctl {start|stop|restart|status|logs|install|uninstall}"
        echo
        echo "  start    - Start the bot (installs if needed)"
        echo "  stop     - Stop the bot"
        echo "  restart  - Stop then start"
        echo "  status   - Show running state"
        echo "  logs     - Tail bot.log"
        echo "  install  - Install plist to ~/Library/LaunchAgents/"
        echo "  uninstall- Remove plist and stop bot"
        exit 1
        ;;
esac
